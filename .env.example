# Server-only example. Never load server secrets in browser scripts.
# Set independent values in each Supabase project's server secret manager.
VIRHANG_ENV=production
VIRHANG_SITE_ORIGIN=https://production.example.invalid
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are server runtime bindings.
# Staging uses VIRHANG_ENV=staging plus its own origin/project/keys.
# Never copy real values, OAuth secrets or tokens into this file.
